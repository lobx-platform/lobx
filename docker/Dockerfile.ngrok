# Docker Official Image, served from AWS's public mirror rather than Docker Hub.
# See docker/Dockerfile.back for why.
FROM public.ecr.aws/docker/library/alpine:latest
# Tracks the v3 stable channel rather than a pinned release: nobody maintains
# this image after the handover, so silently ageing out again is the greater risk.
RUN apk add --no-cache wget && \
    wget -O ngrok.tgz https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-linux-amd64.tgz && \
    tar -xzf ngrok.tgz && \
    chmod +x ngrok && \
    mv ngrok /usr/local/bin/ && \
    rm ngrok.tgz
ENTRYPOINT ["/usr/local/bin/ngrok"]
